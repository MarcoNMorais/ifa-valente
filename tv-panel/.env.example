# Variáveis de referência: o programa não carrega .env automaticamente.
TVHOSP_ADMIN_PASSWORD=
TVHOSP_DATA_DIR=/var/tv-data
NODE_ENV=production
HOST=0.0.0.0
FFMPEG_PATH=/usr/bin/ffmpeg
# Preferido no serviço remoto: SHA-256 da chave gerada no computador.
TVHOSP_CAPTION_TOKEN_SHA256=
# TVHOSP_CAPTION_TOKEN é aceito apenas como alternativa de compatibilidade/teste.
# Não configure chave do GitHub aqui. Não envie valores secretos ao repositório.
